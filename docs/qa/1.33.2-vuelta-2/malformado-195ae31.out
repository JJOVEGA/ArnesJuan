    ligero (x              -> estandar
    ligero (               -> estandar
    ligero (x) y           -> estandar
    ligero(                -> estandar
    ligero ((x)            -> estandar
    ligero (x)             -> estandar
    ligero()               -> estandar
    (ligero)               -> estandar
    (ligero                -> estandar
    ligero )               -> estandar
    **ligero (x**          -> estandar
    ligero (ligero)        -> estandar
    ligero ( ligero )      -> estandar
    ligero (x) (y          -> estandar
    ligero (()             -> estandar
    ligero )(              -> estandar
    ligero ()()            -> estandar
    ligero (ligero         -> estandar
