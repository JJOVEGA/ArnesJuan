+# --- VARIANTE DE UNA CLAVE DE CONTROL: la frontera, escrita una vez ----------------
+#
+# EL DEFECTO (SEC-047, QA-031-01, REQ-023): el lector casa la clave por IGUALDAD EXACTA tras
+# retirar blancos de los extremos y enfasis. `HALLAZGOS ABIERTOS:`, `Hallazgos  abiertos:`, un
+# BOM o un U+200B delante o dentro, un NBSP en lugar del espacio, `- Rigor:` o `1. QA:` no
+# casan, y la linea se resuelve como «no declara campo». Para las claves de control la AUSENCIA
+# abre: sin `Sensible a seguridad:` no hay suelo, sin `QA:` no se exige QA, sin `Hallazgos
+# abiertos:` no hay hallazgos, sin `Rigor:` rige el heredado, y un `Estado:` que no se lee
+# esconde la propia transicion.
+#
+# LA FRONTERA, COMPROBABLE Y SIN LISTA DE CARACTERES. El ESQUELETO de una clave son sus LETRAS
+# ASCII (A-Z, a-z) en minusculas; todo lo demas —blancos de cualquier clase, digitos,
+# puntuacion, marcadores de lista o de cita, CUALQUIER byte >= 0x80— se descarta PARA COMPARAR,
+# nunca para leer. Si el esqueleto es el de una clave de control y la clave leida no es esa
+# clave, la linea es una VARIANTE: esa clave escrita de otra forma.
+#
+# LO QUE QUEDA FUERA, declarado: una letra ASCII de mas, de menos o cambiada (`Rigr:`,
+# `Hallazgo abierto:`: es otra palabra), una letra SUSTITUIDA por un homoglifo (`Е` cirilico,
+# `Ｅ` fullwidth: la letra desaparece del esqueleto), unos dos puntos que no son ASCII (`：`) y
+# una clave de mas de ARNES_CLAVE_ESQ_MAX bytes (no se compara). Todo eso se sigue leyendo como
+# hoy: ausencia del campo. No se «normaliza Unicode» ni se enumera ningun caracter.
+#
+# POR QUE NO SE LEE LA VARIANTE COMO LA CLAVE: ensancharia la tolerancia y obligaria a ELEGIR
+# entre variante y canonica cuando discrepan. Aqui no se elige: la linea se ANOTA y la puerta
+# deniega el cierre por cabecera ambigua (guard-completado). Los VALORES que leen la puerta,
+# el informe, el bloque derivado (`campos-req.awk`) y `arnes-paralelo.sh` no cambian.
+#
+# LOCALE Y COSTE (REQ-023 CA-05, CA-09): bajo `LC_ALL=C` —bytes, sin colacion—, con la clase
+# de letras escrita sin rangos, y solo sobre claves de hasta ARNES_CLAVE_ESQ_MAX bytes, porque
+# `${k//patron/}` crece mas que linealmente con la longitud (SEC-113). Sin procesos.
+ARNES_CLAVES_CONTROL='Estado|QA|Seguridad|Sensible a seguridad|Hallazgos abiertos|Rigor'
+ARNES_CLAVE_ESQ_MAX=256
+arnes_clave_variante() {   # <clave normalizada> -> ARNES_CLAVE_VARIANTE (clave de control o '')
+  local LC_ALL=C k="$1"
+  ARNES_CLAVE_VARIANTE=''
+  [ "${#k}" -le "$ARNES_CLAVE_ESQ_MAX" ] || return 0
+  k="${k//[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz]/}"
+  case "${k,,}" in
+    estado)             ARNES_CLAVE_VARIANTE='Estado' ;;
+    qa)                 ARNES_CLAVE_VARIANTE='QA' ;;
+    seguridad)          ARNES_CLAVE_VARIANTE='Seguridad' ;;
+    sensibleaseguridad) ARNES_CLAVE_VARIANTE='Sensible a seguridad' ;;
+    hallazgosabiertos)  ARNES_CLAVE_VARIANTE='Hallazgos abiertos' ;;
+    rigor)              ARNES_CLAVE_VARIANTE='Rigor' ;;
+  esac
+  return 0
+}
+
+# Cuenta, en UNA cabecera, las declaraciones de claves de control (canonicas y variantes) y
+# publica si la cabecera es AMBIGUA: una variante, o una clave de control declarada mas de una
+# vez. `Hallazgos abiertos:` canonica repetida NO se cuenta aqui: tiene su propia puerta y su
+# propio motivo (REQ-031 CA-A12). La llama quien recorre la cabecera, tras `arnes_norm_clave`;
+# el estado (ARNES_AMBIGUA, ARNES_AMBIGUA_MOTIVO, _ARNES_CTRL_VISTAS) vive en el llamador.
+_arnes_cuenta_control() {   # <n linea> <linea cruda>
+  # `%q` bajo `LC_ALL=C`: todo byte >= 0x80 sale escapado, asi el motivo ENSEÑA el caracter
+  # invisible en vez de reproducirlo (REQ-023 CA-01).
+  local LC_ALL=C k="$ARNES_CLAVE" q
+  if [ -n "$ARNES_CLAVE_VARIANTE" ]; then
+    k="$ARNES_CLAVE_VARIANTE"
+    printf -v q '%q' "${2:0:80}"
+    ARNES_AMBIGUA=1; ARNES_AMBIGUA_MOTIVO+="${ARNES_AMBIGUA_MOTIVO:+; }linea $1: $q es una variante de '$k:'"
+  else
+    arnes_en_vocab "$k" "$ARNES_CLAVES_CONTROL" || return 0
+  fi
+  case "$_ARNES_CTRL_VISTAS" in
+    *"|$k|"*)
+      if [ -z "$ARNES_CLAVE_VARIANTE" ] && [ "$k" != 'Hallazgos abiertos' ]; then
+        ARNES_AMBIGUA=1; ARNES_AMBIGUA_MOTIVO+="${ARNES_AMBIGUA_MOTIVO:+; }linea $1: '$k:' declarada otra vez"
+      fi ;;
+    *) _ARNES_CTRL_VISTAS+="|$k|" ;;
+  esac
+  return 0
 }
 
