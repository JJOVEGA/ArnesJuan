+// Separador exacto contratado por CA-01 de REQ-004: punto y coma seguido de un espacio.
+// Se une con `join`, que por construcción no deja separador inicial ni final.
+const SEPARADOR = '; ';
+
+// CA-02 de REQ-004 contrata hoy exactamente dos valores omitibles: la cadena vacía
+// y el valor nulo. La frontera del conjunto (cadena de sólo espacios, `undefined`,
+// valores no textuales) está escalada en P-01 y NO se decide aquí: ampliarla sería
+// implementar alcance no contratado.
+function seOmite(nombre) {
+  return nombre === '' || nombre === null;
+}
+
 function listaClientes(nombres) {
-  return nombres.join(', ');
