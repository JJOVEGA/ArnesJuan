{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/registra.sh TODOS" },
          { "type": "command", "if": "Bash(touch *)", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/registra.sh CON_IF" }
        ]
      }
    ]
  }
}
