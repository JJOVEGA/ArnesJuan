+// Pruebas de REQ-004 — encabezado del informe mensual (src/formato.js).
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { listaClientes } = require('../src/formato.js');
+
+test('CA-01: varios nombres se unen con «; »', () => {
+  assert.equal(
+    listaClientes(['Ana Rojas', 'Luis Mora', 'Sofía Brenes']),
+    'Ana Rojas; Luis Mora; Sofía Brenes'
+  );
+});
+
+test('CA-01: un solo nombre no lleva separador', () => {
+  assert.equal(listaClientes(['Ana Rojas']), 'Ana Rojas');
+});
+
+test('CA-01: lista vacía produce cadena vacía', () => {
+  assert.equal(listaClientes([]), '');
+});
+
+test('CA-01: la línea no termina en separador', () => {
+  const linea = listaClientes(['Ana Rojas', 'Luis Mora']);
+  assert.equal(linea.endsWith('; '), false);
+  assert.equal(linea.endsWith(';'), false);
+});
+
+test('CA-02: se omiten los nombres que el filtro trata como ausentes', () => {
+  assert.equal(
+    listaClientes(['Ana Rojas', '', 'Luis Mora', null, undefined, 'Sofía Brenes']),
+    'Ana Rojas; Luis Mora; Sofía Brenes'
+  );
+});
+
+test('CA-02: una lista sólo de ausentes produce cadena vacía', () => {
+  assert.equal(listaClientes(['', null, undefined]), '');
+});
+
+test('CA-02: un ausente al final no deja separador colgando', () => {
+  assert.equal(listaClientes(['Ana Rojas', 'Luis Mora', null]), 'Ana Rojas; Luis Mora');
+});
+
+test('CA-01: un nombre con coma sigue siendo un solo cliente', () => {
+  assert.equal(listaClientes(['Vega, Juan']), 'Vega, Juan');
+  assert.equal(
+    listaClientes(['Vega, Juan', 'ACME, S. A.']),
+    'Vega, Juan; ACME, S. A.'
+  );
+});
+
+test('CA-01: la frontera entre clientes se distingue de la coma interna', () => {
+  // Dos clientes con coma interna: partir por «; » devuelve 2 elementos, no 4.
+  const linea = listaClientes(['Vega, Juan', 'ACME, S. A.']);
+  assert.deepEqual(linea.split('; '), ['Vega, Juan', 'ACME, S. A.']);
+  assert.equal(linea.split('; ').length, 2);
+});
